# Local Node settings. npm run start:local loads .env.
PORT=4173
HOST=127.0.0.1
DATA_DIR=./data

# Frontend build. Empty uses the origin serving the website.
# In Vercel, set this to the streaming host's public HTTPS origin.
PUBLIC_API_ORIGIN=

# Comma-separated frontend origins allowed to call the streaming backend.
ALLOWED_ORIGINS=http://127.0.0.1:4173,http://localhost:4173

MEDIA_WORKERS=1
IMAGE_WORKERS=4
MAX_CACHE_JOBS=20
CACHE_TTL_SECONDS=3600
ENCODE_TIMEOUT_MS=900000
ENCODER_PRESET=ultrafast
FFMPEG_PATH=ffmpeg
# 0 lets FFmpeg select automatically. Set to 1 or 2 on a memory-limited host.
FFMPEG_THREADS=0

# Reserved for a trusted API gateway. Leave empty for direct browser playback.
API_TOKEN=
