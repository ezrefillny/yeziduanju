# npm start uses process environment; source this file with your deployment tool.
PORT=4173
HOST=0.0.0.0
DATA_DIR=./data
# For a Vercel frontend, use its exact https origin instead of *.
ALLOWED_ORIGINS=
MEDIA_WORKERS=1
MAX_CACHE_JOBS=20
CACHE_TTL_SECONDS=3600
# Optional full path, otherwise ffmpeg must be on PATH.
# FFMPEG_PATH=/usr/bin/ffmpeg
# Optional access token for API requests (not enabled by default).
# API_TOKEN=
